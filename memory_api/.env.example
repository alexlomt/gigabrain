# Path to the Gigabrain SQLite registry database
GB_REGISTRY_PATH=/path/to/memory.db

# Directory for document store files (optional)
# GB_DOCS_PATH=/path/to/docs

# Agent ID for document indexing (optional, default: shared-docs)
# GB_DOC_INDEX_AGENT=shared-docs

# Admin token — leave empty until you generate a long random value locally.
# Protected requests fail closed while no admin/scoped token is configured.
GB_UI_TOKEN=

# URL import is disabled by default. Enabling it also requires an exact host allowlist.
GB_ENABLE_URL_IMPORT=false
# GB_URL_IMPORT_ALLOWLIST=example.com

# Interactive API docs are disabled by default.
GB_ENABLE_API_DOCS=false

# Optional local recall-diagnostics proxy. Only loopback URLs are accepted;
# non-loopback values are ignored so the console token cannot leave the host.
# GB_RECALL_EXPLAIN_URL=http://127.0.0.1:18789/gb/recall/explain

# Maximum JSON request body for API routes (default: 2500000 bytes).
# GB_MAX_JSON_BODY_BYTES=2500000

# Maximum raw multipart request body before Starlette parsing (default: 11534336 bytes).
# GB_MAX_MULTIPART_BODY_BYTES=11534336
